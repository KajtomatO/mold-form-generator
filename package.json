{
  "name": "mold-form-generator",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Browser app that generates a printable base and cover for pouring silicone casting molds",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.core.json",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@preact/signals": "2.11.4",
    "delatin": "0.2.0",
    "fflate": "0.8.3",
    "manifold-3d": "3.5.4",
    "meshoptimizer": "1.3.0",
    "preact": "10.29.8",
    "three": "0.187.0",
    "three-mesh-bvh": "0.9.18"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
